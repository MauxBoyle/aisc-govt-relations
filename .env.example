# Environment configuration for aisc_gr_statistics
# Copy to .env for development: cp .env.example .env
LOG_LEVEL=DEBUG
LOG_FILE=app.log

# Salesforce Connected App credentials
# Do not commit .env: it contains sensitive credentials.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Optional: Salesforce org URL or full OAuth token endpoint.
SF_LOGIN_URL=
